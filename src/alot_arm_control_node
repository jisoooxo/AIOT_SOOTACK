def standard_dh_matrix(theta, d, a, alpha):
    """Return a 4x4 Standard-DH transform matrix."""
    ct = math.cos(theta)
    st = math.sin(theta)
    ca = math.cos(alpha)
    sa = math.sin(alpha)

    return np.array([
        [ct, -st * ca,  st * sa, a * ct],
        [st,  ct * ca, -ct * sa, a * st],
        [0.0,      sa,       ca,      d],
        [0.0,     0.0,      0.0,    1.0],
    ], dtype=float)


class StandardDHRevoluteLink(Link):
    """
    IKPy-compatible revolute link using the Standard DH convention.

    A_i(q_i) =
        RotZ(theta_offset + joint_sign*q_i)
        * TransZ(d)
        * TransX(a)
        * RotX(alpha)

    q_i itself remains the physical robot joint angle used everywhere else
    in this project. `joint_sign` only maps that physical angle into the
    chosen Standard-DH frame convention.
    """

    def __init__(
        self,
        name,
        d,
        a,
        alpha,
        theta_offset,
        joint_sign,
        bounds,
    ):
        length = max(abs(float(d)), abs(float(a)), 1e-9)
        super().__init__(name=name, length=length, bounds=bounds)

        self.d = float(d)
        self.a = float(a)
        self.alpha = float(alpha)
        self.theta_offset = float(theta_offset)
        self.joint_sign = float(joint_sign)

        self.has_rotation = True
        self.joint_type = "revolute"

    def get_link_frame_matrix(self, q):
        theta = self.theta_offset + self.joint_sign * float(q)

        return standard_dh_matrix(
            theta,
            self.d,
            self.a,
            self.alpha,
        )

    def get_rotation_axis(self):
        # Standard DH actuator rotation occurs around the incoming +Z axis.
        return np.array([0.0, 0.0, 1.0, 1.0], dtype=float)


class StandardDHFixedLink(Link):
    """Fixed Standard-DH transform, used for J4 -> pneumatic tool tip."""

    def __init__(self, name, d=0.0, a=0.0, alpha=0.0, theta=0.0):
        length = max(abs(float(d)), abs(float(a)), 1e-9)
        super().__init__(name=name, length=length)

        self.d = float(d)
        self.a = float(a)
        self.alpha = float(alpha)
        self.theta = float(theta)

        self.has_rotation = False
        self.joint_type = "fixed"

    def get_link_frame_matrix(self, _unused):
        return standard_dh_matrix(
            self.theta,
            self.d,
            self.a,
            self.alpha,
        )


